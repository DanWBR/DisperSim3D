<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="using:Projektanker.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="720"
        x:Class="DisperSim3D.UI.Avalonia.Views.DetectorAllocationDialog"
        Title="Detector Allocation"
        Icon="/Assets/Air.ico"
        Width="980" Height="760"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#444" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#888" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.box">
      <Setter Property="BorderBrush" Value="#DDD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="12">

    <!-- Buttons row -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0"
            Margin="0,10,0,0" Padding="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="BtnCancel" Content="Cancel" MinWidth="80" Click="BtnCancel_Click" />
        <Button x:Name="BtnOK" Content="OK" MinWidth="80" Click="BtnOK_Click"
                IsDefault="True" Background="#0078D4" Foreground="White" />
      </StackPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- Identity -->
        <Border Classes="box">
          <StackPanel>
            <TextBlock Classes="section" Text="Identity" />
            <Grid ColumnDefinitions="80,*,80,*" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Classes="field" Text="Name:" />
              <TextBox   Grid.Column="1" x:Name="TxtName" />
              <TextBlock Grid.Column="2" Classes="field" Text="Study:" />
              <ComboBox  Grid.Column="3" x:Name="CmbStudy" HorizontalAlignment="Stretch"
                         SelectionChanged="CmbStudy_SelectionChanged" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Allocation settings -->
        <Border Classes="box">
          <StackPanel>
            <TextBlock Classes="section" Text="Allocation settings" />

            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto" Margin="0,0,0,4">
              <TextBlock Grid.Column="0" Classes="field" Text="Strategy:" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <RadioButton x:Name="RadioStrategyCov" GroupName="Strategy"
                             IsChecked="True"
                             IsCheckedChanged="Strategy_Changed"
                             Content="Greedy max coverage" />
                <RadioButton x:Name="RadioStrategyRisk" GroupName="Strategy"
                             IsCheckedChanged="Strategy_Changed"
                             Content="Min residual risk (IOGP × wind rose × consequence)" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto" Margin="0,0,0,4">
              <TextBlock Grid.Column="0" Classes="field" Text="Objective:" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <RadioButton x:Name="RadioAll" GroupName="Objective" IsChecked="True"
                             Content="Cover everything" />
                <RadioButton x:Name="RadioPercent" GroupName="Objective"
                             Content="Stop when" Margin="16,0,0,0" />
                <NumericUpDown x:Name="NudTargetPct"
                               Minimum="1" Maximum="100" Value="95" Increment="5"
                               FormatString="F0" Width="80" />
                <TextBlock x:Name="LblTargetPct" Classes="field" Text="% of clouds covered"
                           Margin="4,0,0,0" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="180,120,Auto,*" RowDefinitions="Auto" Margin="0,0,0,4" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Classes="field" Text="Max detectors:" />
              <NumericUpDown Grid.Column="1" x:Name="NudMaxDet"
                             Minimum="0" Maximum="10000" Value="0" Increment="1"
                             FormatString="F0" />
              <TextBlock Grid.Column="2" Classes="field" Text="(0 = unlimited)" />
            </Grid>

            <Grid ColumnDefinitions="180,120" RowDefinitions="Auto" Margin="0,0,0,4">
              <TextBlock Grid.Column="0" Classes="field" Text="Detection radius (m):" />
              <NumericUpDown Grid.Column="1" x:Name="NudRadius"
                             Minimum="0.1" Maximum="500" Value="5" Increment="0.5"
                             FormatString="F2" />
            </Grid>

            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto" Margin="0,0,0,4">
              <TextBlock Grid.Column="0" Classes="field" Text="Breathing zone Z (m):" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <NumericUpDown x:Name="NudMinZ"
                               Minimum="0" Maximum="1000" Value="1.5" Increment="0.5"
                               FormatString="F2" Width="100" />
                <TextBlock Classes="field" Text=" to " />
                <NumericUpDown x:Name="NudMaxZ"
                               Minimum="0" Maximum="1000" Value="3.0" Increment="0.5"
                               FormatString="F2" Width="100" />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto" Margin="0,0,0,4">
              <TextBlock Grid.Column="0" Classes="field" Text="Candidate grid (Nx × Ny × Nz):" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <NumericUpDown x:Name="NudNx"
                               Minimum="2" Maximum="500" Value="60" Increment="1"
                               FormatString="F0" Width="80" />
                <TextBlock Classes="field" Text=" × " />
                <NumericUpDown x:Name="NudNy"
                               Minimum="2" Maximum="500" Value="60" Increment="1"
                               FormatString="F0" Width="80" />
                <TextBlock Classes="field" Text=" × " />
                <NumericUpDown x:Name="NudNz"
                               Minimum="1" Maximum="50" Value="3" Increment="1"
                               FormatString="F0" Width="80" />
              </StackPanel>
            </Grid>

            <CheckBox x:Name="ChkUseExisting" Margin="0,4,0,0"
                      Content="Use existing detectors as seed (only add new ones to fill gaps)" />
          </StackPanel>
        </Border>

        <!-- Risk weights (shown only for MinResidualRisk) -->
        <Border x:Name="GrpRisk" Classes="box" IsVisible="False">
          <StackPanel>
            <TextBlock Classes="section"
                       Text="Risk weights (IOGP 434-01 × wind rose × consequence)" />

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
              <TextBlock Classes="field" Text="Detector POD:" />
              <NumericUpDown x:Name="NudPod"
                             Minimum="0" Maximum="1" Value="1" Increment="0.05"
                             FormatString="F3" Width="80" />
              <CheckBox x:Name="ChkDistanceWeight" Content="Distance weight (Rad 2016)" />
              <TextBlock Classes="field" Text="Wmin:" />
              <NumericUpDown x:Name="NudWmin"
                             Minimum="0" Maximum="1" Value="0.5" Increment="0.05"
                             FormatString="F2" Width="70" />
              <TextBlock Classes="field" Text="Wmax:" />
              <NumericUpDown x:Name="NudWmax"
                             Minimum="0" Maximum="1" Value="1.0" Increment="0.05"
                             FormatString="F2" Width="70" />
            </StackPanel>

            <DataGrid x:Name="GridRisk" Height="160"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True" CanUserReorderColumns="False"
                      GridLinesVisibility="All" HeadersVisibility="Column"
                      RowHeight="22" />

            <TextBlock Classes="hint" Margin="0,4,0,0"
                       Text="Auto frequency = source.LeakFreq × P_wind(direction). Auto consequence = cloud volume × max(1, peak/IDLH) for toxic gases, or × LFL flag for flammables. Uncheck Auto to type a value." />
          </StackPanel>
        </Border>

        <!-- Run row -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
          <Button Grid.Column="0" x:Name="BtnRun" Click="BtnRun_Click"
                  Background="#0078D4" Foreground="White" Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <i:Icon Value="mdi-play" />
              <TextBlock Text="Run allocation" />
            </StackPanel>
          </Button>
          <TextBlock Grid.Column="1" x:Name="LblStatus"
                     Foreground="#888" VerticalAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Grid.Column="2" x:Name="LblCoverage" FontWeight="Bold"
                     VerticalAlignment="Center" />
        </Grid>

        <!-- Results -->
        <Border Classes="box">
          <StackPanel>
            <TextBlock Classes="section" Text="Results" />

            <!-- Risk summary header (only meaningful when Strategy = MinResidualRisk) -->
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,6">
              <TextBlock x:Name="LblTotalRisk" Text="Total risk: —" />
              <TextBlock x:Name="LblResidualRisk" Text="Residual: —" />
              <TextBlock x:Name="LblRrf" FontWeight="Bold" Text="RRF: —" />
            </StackPanel>

            <Grid ColumnDefinitions="*,8,*">
              <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3"
                      Height="220">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Background="#F5F5F5" Padding="6,4"
                             FontWeight="SemiBold" Text="Allocated positions" />
                  <DataGrid x:Name="GridPositions"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                            RowHeight="22" />
                </DockPanel>
              </Border>

              <GridSplitter Grid.Column="1" Background="Transparent" />

              <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3"
                      Height="220">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Background="#F5F5F5" Padding="6,4"
                             FontWeight="SemiBold" Text="Per-cloud coverage" />
                  <DataGrid x:Name="GridPerCloud"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                            RowHeight="22" />
                </DockPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</Window>
