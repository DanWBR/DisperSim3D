<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="520"
        x:Class="DisperSim3D.UI.Avalonia.Views.GasLibraryItemDialog"
        Title="Edit Gas"
        Icon="/Assets/Air.ico"
        Width="640" Height="540" MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#444" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="12">

    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0"
            Margin="0,10,0,0" Padding="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="BtnCancel" Content="Cancel" MinWidth="80" Click="BtnCancel_Click" />
        <Button x:Name="BtnOK" Content="OK" MinWidth="80" Click="BtnOK_Click"
                IsDefault="True" Background="#0078D4" Foreground="White" />
      </StackPanel>
    </Border>

    <!-- Top: name + Pure/Mixture radios -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Classes="field" Text="Name:" />
      <TextBox    Grid.Column="1" x:Name="TxtName" />
      <RadioButton Grid.Column="2" x:Name="RbPure" Content="Pure" GroupName="GasKind"
                   IsChecked="True" Margin="12,0,8,0"
                   IsCheckedChanged="GasKind_Changed" />
      <RadioButton Grid.Column="3" x:Name="RbMixture" Content="Mixture" GroupName="GasKind"
                   IsCheckedChanged="GasKind_Changed" />
    </Grid>

    <!-- Pure panel — 6 numeric properties -->
    <Border x:Name="PnlPure">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnDefinitions="180,*" RowSpacing="6">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Molar Mass (kg/mol):" />
        <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="NudMolarMass"
                       Minimum="0.001" Maximum="1.0" Value="0.016"
                       FormatString="0.0000" Increment="0.001" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="LFL (kg/m³):" />
        <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="NudLFL"
                       Minimum="0" Maximum="10" Value="0.033"
                       FormatString="0.0000" Increment="0.001" />

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="IDLH (kg/m³):" />
        <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="NudIDLH"
                       Minimum="0" Maximum="10" Value="0"
                       FormatString="0.0000" Increment="0.001" />

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="ERPG-1 (kg/m³):" />
        <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="NudERPG1"
                       Minimum="0" Maximum="10" Value="0"
                       FormatString="0.0000" Increment="0.001" />

        <TextBlock Grid.Row="4" Grid.Column="0" Classes="field" Text="ERPG-2 (kg/m³):" />
        <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="NudERPG2"
                       Minimum="0" Maximum="10" Value="0"
                       FormatString="0.0000" Increment="0.001" />

        <TextBlock Grid.Row="5" Grid.Column="0" Classes="field" Text="ERPG-3 (kg/m³):" />
        <NumericUpDown Grid.Row="5" Grid.Column="1" x:Name="NudERPG3"
                       Minimum="0" Maximum="10" Value="0"
                       FormatString="0.0000" Increment="0.001" />
      </Grid>
    </Border>

    <!-- Mixture panel — DataGrid of components + Add/Remove buttons -->
    <DockPanel x:Name="PnlMixture" IsVisible="False">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
        <Button x:Name="BtnAddComponent" Content="+ Add Component"
                Click="BtnAddComponent_Click" />
        <Button x:Name="BtnRemoveComponent" Content="– Remove Selected"
                Click="BtnRemoveComponent_Click" />
        <TextBlock Text="Mole fractions should sum to 1.0"
                   VerticalAlignment="Center" Foreground="#888" />
      </StackPanel>
      <DataGrid x:Name="GridMix"
                AutoGenerateColumns="False"
                CanUserResizeColumns="True" CanUserReorderColumns="False"
                GridLinesVisibility="All" HeadersVisibility="Column"
                RowHeight="22" />
    </DockPanel>

  </DockPanel>
</Window>
