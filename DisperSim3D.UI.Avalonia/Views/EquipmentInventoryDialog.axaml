<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="using:Projektanker.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="540"
        x:Class="DisperSim3D.UI.Avalonia.Views.EquipmentInventoryDialog"
        Title="Equipment Inventory"
        Icon="/Assets/Air.ico"
        Width="860" Height="560"
        MinWidth="660" MinHeight="440"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#444" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="12">

    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0"
            Margin="0,10,0,0" Padding="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="BtnCancel" Content="Cancel" MinWidth="80" Click="BtnCancel_Click" />
        <Button x:Name="BtnOK" Content="OK" MinWidth="80" Click="BtnOK_Click"
                IsDefault="True" Background="#0078D4" Foreground="White" />
      </StackPanel>
    </Border>

    <!-- Hole-size band selector -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Classes="field" Text="Hole-size band:" />
      <ComboBox  Grid.Column="1" x:Name="CmbBand" HorizontalAlignment="Stretch"
                 SelectionChanged="CmbBand_SelectionChanged" />
    </Grid>

    <!-- Frequency display + override -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8" Margin="0,8,0,0">
      <CheckBox Grid.Column="0" x:Name="ChkAuto" Content="Auto-compute from inventory"
                IsCheckedChanged="ChkAuto_Changed" />
      <TextBlock Grid.Column="1" Classes="field" Text="Manual override (events/yr):" />
      <NumericUpDown Grid.Column="2" x:Name="NudManualFreq"
                     Minimum="0" Maximum="1" Value="0" Increment="0.0001"
                     FormatString="F8" Width="140"
                     ValueChanged="NudManualFreq_ValueChanged" />
      <TextBlock Grid.Column="3" x:Name="LblComputedFreq" FontWeight="Bold"
                 VerticalAlignment="Center" Margin="16,0,0,0"
                 Text="Effective: —" />
    </Grid>

    <!-- Toolbar -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,6,0,0">
      <Button Grid.Column="0" x:Name="BtnAdd" Click="BtnAdd_Click">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <i:Icon Value="mdi-plus" />
          <TextBlock Text="Add item" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" x:Name="BtnRemove" Click="BtnRemove_Click">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <i:Icon Value="mdi-minus" />
          <TextBlock Text="Remove selected" />
        </StackPanel>
      </Button>
      <TextBlock Grid.Column="2" Foreground="#888" FontSize="10" VerticalAlignment="Center"
                 Margin="8,0,0,0"
                 Text="(Length in metres for pipe types; count for everything else.)" />
    </Grid>

    <!-- Inventory grid -->
    <DataGrid x:Name="GridInventory"
              AutoGenerateColumns="False"
              CanUserResizeColumns="True" CanUserReorderColumns="False"
              GridLinesVisibility="All" HeadersVisibility="Column"
              RowHeight="24" />

  </DockPanel>
</Window>
