<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="260"
        x:Class="DisperSim3D.UI.Avalonia.Views.MonitorPointDialog"
        Title="Add Monitor Point"
        Icon="/Assets/Air.ico"
        Width="440" SizeToContent="Height"
        MinHeight="240" MaxHeight="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#444" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="12">
    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0"
            Margin="0,10,0,0" Padding="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="BtnCancel" Content="Cancel" MinWidth="80" Click="BtnCancel_Click" />
        <Button x:Name="BtnOK" Content="OK" MinWidth="80" Click="BtnOK_Click"
                IsDefault="True" Background="#0078D4" Foreground="White" />
      </StackPanel>
    </Border>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          ColumnDefinitions="120,*" RowSpacing="6">
      <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Name:" />
      <TextBox    Grid.Row="0" Grid.Column="1" x:Name="TxtName" Text="Monitor1" />

      <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="X (m, +East):" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="NudX"
                     Minimum="-10000" Maximum="10000" Value="0"
                     FormatString="0.00" Increment="0.5" />

      <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Y (m, +North):" />
      <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="NudY"
                     Minimum="-10000" Maximum="10000" Value="0"
                     FormatString="0.00" Increment="0.5" />

      <TextBlock Grid.Row="3" Grid.Column="0" Classes="field" Text="Z (m, above ground):" />
      <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="NudZ"
                     Minimum="-10000" Maximum="10000" Value="2"
                     FormatString="0.00" Increment="0.5" />
    </Grid>
  </DockPanel>
</Window>
