<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="420"
        x:Class="DisperSim3D.UI.Avalonia.Views.BatchExportDialog"
        Title="Batch Export Images"
        Icon="/Assets/Air.ico"
        Width="480" SizeToContent="Height"
        MinHeight="380" MaxHeight="640"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#444" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="12">

    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0"
            Margin="0,10,0,0" Padding="0,8,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="BtnCancel" Content="Cancel" MinWidth="80" Click="BtnCancel_Click" />
        <Button x:Name="BtnOK" Content="Export" MinWidth="80" Click="BtnOK_Click"
                IsDefault="True" Background="#0078D4" Foreground="White" />
      </StackPanel>
    </Border>

    <StackPanel Spacing="6">
      <TextBlock Text="Camera presets" FontWeight="Bold" />
      <TextBlock Foreground="#666" FontSize="10" TextWrapping="Wrap"
                 Text="Select which saved camera angles to render. One PNG is generated per checked preset." />

      <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3"
              Height="180" Padding="2">
        <ScrollViewer>
          <ItemsControl x:Name="PresetList" />
        </ScrollViewer>
      </Border>

      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="100,*,Auto" RowSpacing="6" Margin="0,4,0,0">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Width:" />
        <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="NudWidth"
                       Minimum="320" Maximum="7680" Value="1920" Increment="10"
                       FormatString="F0" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Height:" />
        <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="NudHeight"
                       Minimum="240" Maximum="4320" Value="1080" Increment="10"
                       FormatString="F0" />

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Output:" />
        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TxtFolder" />
        <Button    Grid.Row="2" Grid.Column="2" Content="..." MinWidth="36" Margin="4,0,0,0"
                   Click="BtnBrowse_Click" />
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
