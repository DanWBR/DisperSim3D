<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="using:Projektanker.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
        x:Class="DisperSim3D.UI.Avalonia.Views.ValidationDialog"
        Title="Validate against Benchmarks"
        Icon="/Assets/Air.ico"
        Width="980" Height="700"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="10">

    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0"
            Margin="0,8,0,0" Padding="0,8,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" x:Name="BtnExport" HorizontalAlignment="Left"
                Click="BtnExport_Click">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <i:Icon Value="mdi-file-document-arrow-right-outline" />
            <TextBlock Text="Export Markdown..." />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" x:Name="BtnClose" Content="Close" MinWidth="80"
                Click="BtnClose_Click"
                IsDefault="True" Background="#0078D4" Foreground="White" />
      </Grid>
    </Border>

    <!-- Top description -->
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#555" FontSize="11"
               Margin="0,0,0,8"
               Text="Pick one or more .dsbench files. Each is run end-to-end and scored against the published acceptance ranges (Hanna SPMs)." />

    <Grid RowDefinitions="*,8,Auto,8,2*,8,Auto">

      <!-- File list + add/remove -->
      <Grid Grid.Row="0" ColumnDefinitions="*,8,160">
        <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
          <ListBox x:Name="LstFiles" SelectionMode="Multiple" />
        </Border>
        <StackPanel Grid.Column="2" Spacing="6">
          <Button x:Name="BtnAdd" HorizontalAlignment="Stretch" Click="BtnAdd_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <i:Icon Value="mdi-plus" />
              <TextBlock Text="Add benchmark..." />
            </StackPanel>
          </Button>
          <Button x:Name="BtnRemove" HorizontalAlignment="Stretch" Click="BtnRemove_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <i:Icon Value="mdi-minus" />
              <TextBlock Text="Remove" />
            </StackPanel>
          </Button>
          <Button x:Name="BtnClear" HorizontalAlignment="Stretch" Click="BtnClear_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <i:Icon Value="mdi-trash-can-outline" />
              <TextBlock Text="Clear" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Run button -->
      <Button Grid.Row="2" x:Name="BtnRun" Content="Run All"
              HorizontalAlignment="Stretch" FontWeight="Bold"
              Background="#0078D4" Foreground="White"
              Padding="6,4" Click="BtnRun_Click" />

      <!-- Results grid -->
      <Border Grid.Row="4" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
        <DataGrid x:Name="GridResults"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True" CanUserReorderColumns="False"
                  GridLinesVisibility="All" HeadersVisibility="Column"
                  RowHeight="22" />
      </Border>

      <!-- Log -->
      <Border Grid.Row="6" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3"
              MaxHeight="120" Height="120" Padding="2">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <TextBox x:Name="TxtLog"
                   IsReadOnly="True" AcceptsReturn="True"
                   BorderThickness="0" Background="Transparent"
                   FontFamily="Consolas,Menlo,monospace" FontSize="11" />
        </ScrollViewer>
      </Border>

    </Grid>
  </DockPanel>
</Window>
