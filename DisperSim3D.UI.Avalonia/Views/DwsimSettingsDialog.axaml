<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="320"
        x:Class="DisperSim3D.UI.Avalonia.Views.DwsimSettingsDialog"
        Title="DWSIM Settings (Application)"
        Icon="/Assets/Air.ico"
        Width="660" SizeToContent="Height"
        MinHeight="280" MaxHeight="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#444" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.box">
      <Setter Property="BorderBrush" Value="#DDD" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#888" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="12">

    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0"
            Margin="0,10,0,0" Padding="0,8,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" x:Name="BtnTest" Content="Test connection" MinWidth="120"
                Click="BtnTest_Click" />
        <Button Grid.Column="2" x:Name="BtnCancel" Content="Cancel" MinWidth="80" Click="BtnCancel_Click" />
        <Button Grid.Column="3" x:Name="BtnOK" Content="OK" MinWidth="80" Click="BtnOK_Click"
                IsDefault="True" Background="#0078D4" Foreground="White" />
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" x:Name="LblStatus"
               Foreground="#888" Margin="0,4,0,0" TextWrapping="Wrap" />

    <StackPanel>
      <Border Classes="box">
        <StackPanel>
          <TextBlock Classes="section" Text="DWSIM Installation" />
          <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Install directory:" />
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtInstallPath" />
            <Button    Grid.Row="0" Grid.Column="2" x:Name="BtnBrowse" Content="Browse..." MinWidth="80"
                       Margin="4,0,0,0" Click="BtnBrowse_Click" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="hint"
                       Text="Folder containing DWSIM.Automation.FluentAPI.dll." />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="box">
        <StackPanel>
          <TextBlock Classes="section" Text="Default Property Package" />
          <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Property Package:" />
            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CmbPropertyPackage"
                       HorizontalAlignment="Stretch" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="hint"
                       Text="Used by every mixture flash. Peng-Robinson 1978 is the default for gas dispersion." />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

  </DockPanel>
</Window>
