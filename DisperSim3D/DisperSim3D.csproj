<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-targeting: net10.0 lets the engine build on Linux/macOS for the
         CLI and cross-platform consumers; net10.0-windows enables the WPF
         interop conversions used by DisperSim3D.UI.Wpf and DisperSim3D.App.
         The windows TFM is only included when MSBuild is running on Windows
         (otherwise NETSDK1100 fires the moment the SDK tries to restore the
         windows variant on Linux/macOS, even when nothing consumes it). -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net10.0;net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>DisperSim3D</RootNamespace>
    <AssemblyName>DisperSim3D</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Title>DisperSim3D</Title>
    <Description>Open Source 3D Gas Dispersion Analysis Library</Description>
    <Company>Daniel Wagner Oliveira de Medeiros</Company>
    <Product>DisperSim3D</Product>
    <Copyright>Copyright © 2026 Daniel Wagner Oliveira de Medeiros</Copyright>
    <Version>1.0.0</Version>
    <NoWarn>WFO1000</NoWarn>
  </PropertyGroup>

  <!-- Windows-only flags: WPF/WinForms types are referenced only by the
       #if WINDOWS implicit-conversion blocks in DisperSim3D.Geometry; the
       net10.0 variant compiles those blocks out so it stays cross-platform. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Resources\Models3D\CSTR.obj" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Icons\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Icons\Air.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
