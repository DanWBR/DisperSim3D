{
  "$schema": "dsbench/v1",
  "name": "Prairie-Grass-Run35-E",
  "citation": "Barad, M.L. (1958). Project Prairie Grass, A Field Program in Diffusion. AFCRL-TR-58-235. Run 35: stability E, arc-maximum SO2 concentrations at 50-800 m.",
  "description": "Prairie Grass Run 35. Stable (E) conditions: Q=38.8 g/s SO2 at 0.46 m height, U(2m)=1.80 m/s, dT=-1.39 C. Flat short-grass prairie, z0=0.006 m. 10-min averaged arc-max concentrations at 1.5 m height. Low wind, strong concentration persistence downwind.",

  "source": {
    "name": "PG Run 35 ground source",
    "gas": {
      "name": "SO2",
      "molarMass": 0.064066,
      "lfl": 0,
      "ufl": 0,
      "isCryogenic": false
    },
    "position": [0, 0, 0.46],
    "releaseRateKgPerS": 0.0388,
    "releaseDurationS": 600,
    "stackDiameterM": 0,
    "exitTemperatureK": 300,
    "exitVelocityMPerS": 0
  },

  "meteo": {
    "windSpeed": 1.80,
    "windDirectionDeg": 270,
    "stability": "E",
    "ambientTemperature": 298,
    "ambientPressure": 101325,
    "windMeasurementHeightM": 2,
    "roughnessLengthM": 0.006
  },

  "domain": {
    "sizeM": 1000,
    "gridResolution": 80,
    "durationS": 600,
    "timeStepS": 1.0
  },

  "solver": "GaussianPlume",
  "concentrationKind": "FinalSnapshot",
  "unit": "KgPerM3",

  "sensors": [
    { "name": "arc-50m",  "position": [50,  0, 1.5], "measuredKgM3": 6.60e-4 },
    { "name": "arc-100m", "position": [100, 0, 1.5], "measuredKgM3": 5.75e-4 },
    { "name": "arc-200m", "position": [200, 0, 1.5], "measuredKgM3": 2.53e-4 },
    { "name": "arc-400m", "position": [400, 0, 1.5], "measuredKgM3": 7.62e-5 },
    { "name": "arc-800m", "position": [800, 0, 1.5], "measuredKgM3": 1.38e-5 }
  ],

  "referenceModelSpms": {
    "model": "FLACS v8",
    "citation": "Hanna, Hansen, Dharmavaram 2004 (Atmospheric Environment 38, 4675-4687), Table 2 - aggregate over 43 Prairie Grass trials.",
    "notes": "Cohort-average SPMs from FLACS evaluation.",
    "MRB": 0.18,
    "FAC2": 0.49,
    "MG": 1.53,
    "VG": 2.75
  },

  "acceptance": {
    "ReferenceMatchTolerance": {
      "MRB":  0.5,
      "FAC2": 0.2,
      "MG":   0.5,
      "VG":   1.0
    }
  }
}
