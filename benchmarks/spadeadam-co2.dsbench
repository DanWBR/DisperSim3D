{
  "$schema": "dsbench/v1",
  "name": "Spadeadam-DF1-Test5",
  "citation": "Witlox, H.W.M., Harper, M., Oke, A. (2012). Phast validation against BP DF1 CO2 experiments. IChemE Hazards XXIII Symp. Series 158. Extended in Witlox et al. (2014) J. Loss Prev. Process Ind. 30, 243-255. BP CO2PIPETRANS JIP at Spadeadam UK, Test 5.",
  "dataConfidence": "Medium",
  "description": "Spadeadam BP DF1 Test 5 - high-pressure cold liquid CO2 release through 25.62 mm orifice. 157.7 barg / 5 C storage, 41.17 kg/s discharge for 40 s. Sensor array (43 cells) on arcs at 5, 10, 20, 40 m at heights 0.3 / 1 / 3 m. NOTE: in DisperSim's target range (25 mm orifice, pressurized supercritical-to-liquid). Sensor values approximated from Witlox 2012 Fig. 6 (11-s-avg centerline mol% CO2) - confidence medium for params (primary Table 1), low for per-arc values (figure digitization). Full per-sensor dataset in DNV CO2PIPETRANS JIP WP1 report (proprietary).",

  "source": {
    "name": "Spadeadam DF1 Test 5 CO2 jet",
    "gas": {
      "name": "CO2",
      "molarMass": 0.04401,
      "lfl": 0,
      "ufl": 0,
      "isCryogenic": false
    },
    "position": [0, 0, 1.8],
    "releaseRateKgPerS": 41.17,
    "releaseDurationS": 40,
    "stackDiameterM": 0.02562,
    "exitTemperatureK": 230,
    "exitVelocityMPerS": 230,
    "twoPhase": {
      "enabled": false,
      "compoundName": "Carbon dioxide",
      "vesselPressurePa": 15869325,
      "vesselTemperatureK": 278.15,
      "orificeDiameterM": 0.02562,
      "dischargeCoefficient": 0.65,
      "targetExpandedVelocityMS": 100.0
    }
  },

  "meteo": {
    "windSpeed": 5.13,
    "windDirectionDeg": 270,
    "stability": "D",
    "ambientTemperature": 279,
    "ambientPressure": 101325,
    "windMeasurementHeightM": 10,
    "roughnessLengthM": 0.05
  },

  "domain": {
    "sizeM": 80,
    "gridResolution": 80,
    "durationS": 90,
    "timeStepS": 0.5
  },

  "solver": "FluidX3DDispersion",
  "concentrationKind": "PeakOverTime",
  "unit": "MassFraction",

  "sensors": [
    { "name": "jet-5m",  "position": [5,  0, 1.5], "measuredKgM3": 0.467 },
    { "name": "jet-10m", "position": [10, 0, 1.5], "measuredKgM3": 0.198 },
    { "name": "jet-20m", "position": [20, 0, 1.5], "measuredKgM3": 0.0703 },
    { "name": "jet-40m", "position": [40, 0, 1.5], "measuredKgM3": 0.0226 }
  ],

  "acceptance": {
    "MRB":  { "min": -0.67, "max": 0.67 },
    "RMSE": { "max": 3.0 },
    "FAC2": { "min": 0.3, "max": 2.0 },
    "MG":   { "min": 0.5, "max": 2.0 },
    "VG":   { "max": 4.0 }
  }
}
