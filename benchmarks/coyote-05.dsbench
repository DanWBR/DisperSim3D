{
  "$schema": "dsbench/v1",
  "name": "Coyote-Trial05",
  "citation": "Goldwire, H.C. et al. (1983). Coyote series data report - LLNL/NWC 1981 LNG spill tests dispersion, vapor burn, and rapid-phase-transition. LLNL UCID-19953. Trial 5. Parameters from PHMSA MVD Rev B 2024 Table 2-14.",
  "description": "Coyote Trial 5 - LNG spill on water, dispersion phase before ignition. 22.8 m^3 LNG over 98 s (~96 kg/s). Frenchman Flat 1981. Wind 7.4 m/s, stability D. Companion to Coyote 3 with different stability and slightly larger pool. Sensors on arcs at 140, 300, 400 m, ~1 m height. Sensor values approximate from Hansen 2010 validation figures (confidence medium-low).",

  "source": {
    "name": "Coyote T5 LNG pool",
    "gas": {
      "name": "CH4",
      "molarMass": 0.01604,
      "lfl": 0,
      "ufl": 0,
      "isCryogenic": true
    },
    "position": [0, 0, 1.5],
    "releaseRateKgPerS": 96.4,
    "releaseDurationS": 98,
    "stackDiameterM": 12.0,
    "exitTemperatureK": 111,
    "exitVelocityMPerS": 0.08
  },

  "meteo": {
    "windSpeed": 7.4,
    "windDirectionDeg": 270,
    "stability": "D",
    "ambientTemperature": 301,
    "ambientPressure": 93600,
    "windMeasurementHeightM": 3,
    "roughnessLengthM": 0.0002
  },

  "domain": {
    "sizeM": 800,
    "gridResolution": 100,
    "durationS": 240,
    "timeStepS": 1.0
  },

  "solver": "RhoReactingBuoyantFoam",
  "concentrationKind": "PeakOverTime",
  "unit": "MassFraction",

  "sensors": [
    { "name": "arc-140m", "position": [140, 0, 1.0], "measuredKgM3": 0.030 },
    { "name": "arc-300m", "position": [300, 0, 1.0], "measuredKgM3": 0.012 },
    { "name": "arc-400m", "position": [400, 0, 1.0], "measuredKgM3": 0.008 }
  ],

  "referenceModelSpms": {
    "model": "FLACS v9",
    "citation": "Hansen, Gavelli, Ichard, Davis 2010 (J. Loss Prev. Process Ind. 23, 857-877) - unobstructed-group aggregate (Burro, Coyote, Maplin Sands, Thorney Island).",
    "notes": "Per-trial SPMs not tabulated in open paper; numbers below are the cohort aggregate for LNG dispersion tests without obstacles. FLACS used custom source-term and high-resolution grid.",
    "FAC2": 0.94,
    "MG": 1.18,
    "VG": 1.14
  },

  "acceptance": {
    "ReferenceMatchTolerance": {
      "MRB":  0.5,
      "FAC2": 0.3,
      "MG":   0.5,
      "VG":   1.5
    }
  }
}
