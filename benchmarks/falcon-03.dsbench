{
  "$schema": "dsbench/v1",
  "name": "Falcon-Trial03",
  "citation": "Brown, T.C. et al. (1990). Falcon series data report - 1987 LNG vapor barrier verification field trials. GRI-89/0138 / UCRL-CR-104316. Trial 3 (smallest Falcon spill). Parameters from PHMSA MVD Rev B 2024 Table 2-20.",
  "description": "Falcon Trial 3 - smallest Falcon series spill. ~28 m^3 LNG, 73 kg/s for ~96 s, into 60 m x 40 m basin inside 88 m x 44 m vapour fence (8.7 m). Wind 4.1 m/s, stability D. Sensors at fence (50 m), 150 m, 250 m downwind. NOTE: fence retention not modelled by stock solver.",

  "source": {
    "name": "Falcon T3 LNG pool inside fence",
    "gas": {
      "name": "CH4",
      "molarMass": 0.01604,
      "lfl": 0,
      "ufl": 0,
      "isCryogenic": true
    },
    "position": [0, 0, 0.5],
    "releaseRateKgPerS": 73.0,
    "releaseDurationS": 96,
    "stackDiameterM": 40,
    "exitTemperatureK": 111,
    "exitVelocityMPerS": 0.05
  },

  "meteo": {
    "windSpeed": 4.1,
    "windDirectionDeg": 270,
    "stability": "D",
    "ambientTemperature": 307,
    "ambientPressure": 87000,
    "windMeasurementHeightM": 2,
    "roughnessLengthM": 0.008
  },

  "domain": {
    "sizeM": 500,
    "gridResolution": 100,
    "durationS": 300,
    "timeStepS": 1.0
  },

  "solver": "RhoReactingBuoyantFoam",
  "concentrationKind": "PeakOverTime",
  "unit": "MassFraction",

  "sensors": [
    { "name": "fence-50m",  "position": [50,  0, 1.0], "measuredKgM3": 0.030 },
    { "name": "arc-150m",   "position": [150, 0, 1.0], "measuredKgM3": 0.020 },
    { "name": "arc-250m",   "position": [250, 0, 1.0], "measuredKgM3": 0.014 }
  ],

  "referenceModelSpms": {
    "model": "FLACS v9",
    "citation": "Hansen, Gavelli, Ichard, Davis 2010 (J. Loss Prev. Process Ind. 23, 857-877) - Falcon-with-fence obstructed group aggregate.",
    "notes": "FLACS performed POORLY on Falcon due to vapor-fence source-term limitations - FAC2 dropped to 0.0 on this cohort. Bench acknowledges that even commercial CFD struggles here; DisperSim is given the same allowance.",
    "FAC2": 0.0,
    "MG": 5.56,
    "VG": 23.65
  },

  "acceptance": {
    "ReferenceMatchTolerance": {
      "MRB":  1.0,
      "FAC2": 0.3,
      "MG":   2.0,
      "VG":   10.0
    }
  }
}
