    "fuel": "kerosene",
    "poolDiameterM": 30.0,
    "burnRateKgM2S": 0.065,
    "heatOfCombustionJKg": 43000000,
    "radiativeFraction": 0.2,
    "fuelMolarMassKgMol": 0.17,
