{
  "$schema": "dsbench/v1",
  "name": "Burro3",
  "citation": "Koopman, R.P. et al. (1982). LLNL/NWC 1980 LNG spill tests. LLNL UCID-19075. Burro Trial 3. Parameters from PHMSA MVD Rev B 2024 Table 2-8. Sensor values approximated from Hansen et al. 2010 J. Loss Prev. Process Ind. 23 figures.",
  "description": "Burro Trial 3 - LNG spill on water from 0.61 m pipe. 24.4 m^3 LNG over ~167 s (~80 kg/s effective). Frenchman Flat 1980. Different stability from Burro 8 (F) and Burro 9 (D): Burro 3 had near-neutral C stability with 5.4 m/s wind. Sensors on arcs at 57, 140, 400 m, ~1 m height. NOTE: regression baseline target should be captured from current engine output; sensor values approximate from Hansen 2010 figures (confidence medium-low). For authoritative tables consult Koopman 1982 UCID-19075 Vol. 2 appendices.",

  "source": {
    "name": "Burro3 LNG pool",
    "gas": {
      "name": "CH4",
      "molarMass": 0.01604,
      "lfl": 0,
      "ufl": 0,
      "isCryogenic": true
    },
    "position": [0, 0, 0.5],
    "releaseRateKgPerS": 80.4,
    "releaseDurationS": 167,
    "stackDiameterM": 17.0,
    "exitTemperatureK": 111,
    "exitVelocityMPerS": 0.05
  },

  "meteo": {
    "windSpeed": 5.4,
    "windDirectionDeg": 270,
    "stability": "C",
    "ambientTemperature": 308,
    "ambientPressure": 93000,
    "windMeasurementHeightM": 2,
    "roughnessLengthM": 0.0002
  },

  "domain": {
    "sizeM": 800,
    "gridResolution": 100,
    "durationS": 250,
    "timeStepS": 1.0
  },

  "solver": "RhoReactingBuoyantFoam",
  "concentrationKind": "PeakOverTime",
  "unit": "MassFraction",

  "sensors": [
    { "name": "arc-57m_centerline",  "position": [57,  0, 1.0], "measuredKgM3": 0.040 },
    { "name": "arc-140m_centerline", "position": [140, 0, 1.0], "measuredKgM3": 0.020 },
    { "name": "arc-400m_centerline", "position": [400, 0, 1.0], "measuredKgM3": 0.006 }
  ],

  "acceptance": {
    "MRB":  { "min": -0.67, "max": 0.67 },
    "RMSE": { "max": 3.0 },
    "FAC2": { "min": 0.3, "max": 2.0 },
    "MG":   { "min": 0.5, "max": 2.0 },
    "VG":   { "max": 4.0 }
  }
}
