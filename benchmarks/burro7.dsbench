{
  "$schema": "dsbench/v1",
  "name": "Burro7",
  "citation": "Koopman, R.P. et al. (1982). LLNL/NWC 1980 LNG spill tests. LLNL UCID-19075. Burro Trial 7. Parameters from PHMSA MVD Rev B 2024 Table 2-8. Sensor values approximated from Hansen et al. 2010 J. Loss Prev. Process Ind. 23 figures.",
  "dataConfidence": "Medium",
  "description": "Burro Trial 7 - LNG spill on water from 0.61 m pipe. 39.4 m^3 LNG over ~174 s (~123 kg/s effective). Frenchman Flat 1980. High wind (8.4 m/s) with neutral C stability - the high-wind case in the Burro series. Sensors on arcs at 57, 140, 400 m, ~1 m height. NOTE: high wind reduces near-field concentrations vs Burro 8/9. Sensor values approximate from Hansen 2010 figures (confidence medium-low).",

  "source": {
    "name": "Burro7 LNG pool",
    "gas": {
      "name": "CH4",
      "molarMass": 0.01604,
      "lfl": 0,
      "ufl": 0,
      "isCryogenic": true
    },
    "position": [0, 0, 0.5],
    "releaseRateKgPerS": 123.4,
    "releaseDurationS": 174,
    "stackDiameterM": 20.0,
    "exitTemperatureK": 111,
    "exitVelocityMPerS": 0.05
  },

  "meteo": {
    "windSpeed": 8.4,
    "windDirectionDeg": 270,
    "stability": "C",
    "ambientTemperature": 307,
    "ambientPressure": 93000,
    "windMeasurementHeightM": 2,
    "roughnessLengthM": 0.0002
  },

  "domain": {
    "sizeM": 1000,
    "gridResolution": 100,
    "durationS": 300,
    "timeStepS": 1.0
  },

  "solver": "RhoReactingBuoyantFoam",
  "concentrationKind": "PeakOverTime",
  "unit": "MassFraction",

  "sensors": [
    { "name": "arc-57m_centerline",  "position": [57,  0, 1.0], "measuredKgM3": 0.035 },
    { "name": "arc-140m_centerline", "position": [140, 0, 1.0], "measuredKgM3": 0.014 },
    { "name": "arc-400m_centerline", "position": [400, 0, 1.0], "measuredKgM3": 0.004 }
  ],

  "referenceModelSpms": {
    "model": "FLACS v9",
    "citation": "Hansen, Gavelli, Ichard, Davis 2010 (J. Loss Prev. Process Ind. 23, 857-877) - unobstructed-group aggregate (Burro, Coyote, Maplin Sands, Thorney Island).",
    "notes": "Per-trial SPMs not tabulated in open paper; numbers below are the cohort aggregate for LNG dispersion tests without obstacles. FLACS used custom source-term and high-resolution grid.",
    "FAC2": 0.94,
    "MG": 1.18,
    "VG": 1.14
  },

  "acceptance": {
    "ReferenceMatchTolerance": {
      "MRB":  0.5,
      "FAC2": 0.3,
      "MG":   0.5,
      "VG":   1.5
    }
  }
}
