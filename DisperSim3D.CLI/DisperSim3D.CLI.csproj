<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0 — the headless runner consumes only the cross-platform
         engine API and runs on Linux/macOS as well as Windows. The WPF/WinForms
         desktop SDK is intentionally NOT enabled. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>DisperSim3D.CLI</RootNamespace>
    <AssemblyName>DisperSim3D.CLI</AssemblyName>
    <NoWarn>WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DisperSim3D\DisperSim3D.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\bin\FluidX3D.dll" Condition="Exists('..\bin\FluidX3D.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
