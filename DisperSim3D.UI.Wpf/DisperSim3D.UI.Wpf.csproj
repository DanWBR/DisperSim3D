<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>DisperSim3D.UI.Wpf</RootNamespace>
    <AssemblyName>DisperSim3D.UI.Wpf</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Title>DisperSim3D.UI.Wpf</Title>
    <Description>WPF + WinForms UI layer for DisperSim 3D. Holds every type that
    touches System.Windows.Media.Media3D, HelixToolkit, HandyControl, or
    DockPanelSuite, so the calculation engine (DisperSim3D.csproj) stays
    cross-platform.</Description>
    <Company>Daniel Wagner Oliveira de Medeiros</Company>
    <Product>DisperSim3D</Product>
    <Copyright>Copyright © 2026 Daniel Wagner Oliveira de Medeiros</Copyright>
    <Version>1.0.0</Version>
    <NoWarn>WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="DockPanelSuite" Version="3.1.1" />
    <PackageReference Include="DockPanelSuite.ThemeVS2015" Version="3.1.1" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DisperSim3D\DisperSim3D.csproj" />
  </ItemGroup>
</Project>
