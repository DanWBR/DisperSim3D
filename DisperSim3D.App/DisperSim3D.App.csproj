<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DisperSim3D.App</RootNamespace>
    <AssemblyName>DisperSim3D.App</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Title>DisperSim3D.App</Title>
    <Description>DisperSim3D Application</Description>
    <Copyright>Copyright 2026 Daniel Wagner Oliveira de Medeiros</Copyright>
    <Version>0.1.1</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Win32 icon resource for the .exe itself (Explorer, taskbar pin, shortcuts).
         The forms load the same file at runtime via FormExtensions.AppIcon. -->
    <ApplicationIcon>..\DisperSim3D\Resources\Icons\Air.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DisperSim3D\DisperSim3D.csproj" />
    <ProjectReference Include="..\DisperSim3D.UI.Wpf\DisperSim3D.UI.Wpf.csproj" />
  </ItemGroup>

  <!-- Auto-copy the FluidX3D native library next to the .exe so
       DllImport("FluidX3D") resolves at runtime. Three flavours (Windows DLL
       from MSBuild, Linux .so from make-disp-bridge.sh, macOS .dylib idem)
       so the App can run from a Unix dev environment too. -->
  <ItemGroup>
    <None Include="..\bin\FluidX3D.dll" Condition="Exists('..\bin\FluidX3D.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="..\FluidX3D\bin\libFluidX3D.so"
          Condition="Exists('..\FluidX3D\bin\libFluidX3D.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="..\FluidX3D\bin\libFluidX3D.dylib"
          Condition="Exists('..\FluidX3D\bin\libFluidX3D.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
